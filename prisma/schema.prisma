// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────
model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  password_hash String
  phone         String?
  address       String?   @db.Text
  role          String    @default("user") // "user" | "admin"
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  orders        Order[]
  posts         Post[]
  order_status_histories OrderStatusHistory[]

  @@map("users")
}

// ─────────────────────────────────────────────
// CATEGORIES (dùng chung cho product & post)
// ─────────────────────────────────────────────
model Category {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?   @db.Text
  image_url   String?   @db.Text
  icon        String?
  type        String    // "product" | "post"
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  products    Product[]
  posts       Post[]

  @@map("categories")
}

// ─────────────────────────────────────────────
// PRODUCTS
// ─────────────────────────────────────────────
model Product {
  id                Int       @id @default(autoincrement())
  name              String
  slug              String    @unique
  short_description String?   @db.Text
  description       String?   @db.LongText
  price             Decimal   @db.Decimal(12, 2)
  sale_price        Decimal?  @db.Decimal(12, 2)
  sku               String?   @unique
  stock             Int       @default(0)
  status            String    @default("active") // "active" | "inactive" | "draft"
  is_customizable   Boolean   @default(false)
  is_featured       Boolean   @default(false)
  featured_image    String?   @db.Text
  category_id       Int?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  category          Category? @relation(fields: [category_id], references: [id])
  images            ProductImage[]
  options           ProductOption[]
  cart_items        CartItem[]
  order_items       OrderItem[]
  reviews           Review[]

  @@map("products")
}

model ProductImage {
  id          Int     @id @default(autoincrement())
  product_id  Int
  image_url   String  @db.Text
  alt_text    String?
  sort_order  Int     @default(0)

  product     Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductOption {
  id            Int     @id @default(autoincrement())
  product_id    Int
  option_name   String  // "Màu sắc", "Charm", "Kiểu dây"
  option_type   String  // "color" | "select" | "text"
  option_values String  @db.Text // JSON array: ["Đỏ","Xanh","Vàng"]

  product       Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("product_options")
}

// ─────────────────────────────────────────────
// CARTS
// ─────────────────────────────────────────────
model Cart {
  id          Int       @id @default(autoincrement())
  user_id     Int?
  session_id  String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  items       CartItem[]

  @@map("carts")
}

model CartItem {
  id               Int     @id @default(autoincrement())
  cart_id          Int
  product_id       Int
  quantity         Int     @default(1)
  selected_options String? @db.Text // JSON
  custom_note      String? @db.Text
  price_snapshot   Decimal @db.Decimal(12, 2)

  cart             Cart    @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  product          Product @relation(fields: [product_id], references: [id])

  @@map("cart_items")
}

// ─────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────
model Order {
  id               Int       @id @default(autoincrement())
  order_code       String    @unique // MSH-XXXXXX
  user_id          Int?
  customer_name    String
  customer_email   String
  customer_phone   String
  shipping_address String    @db.Text
  note             String?   @db.Text
  subtotal         Decimal   @db.Decimal(12, 2)
  shipping_fee     Decimal   @db.Decimal(12, 2) @default(0)
  total            Decimal   @db.Decimal(12, 2)
  payment_method   String    @default("bank_transfer")
  payment_status   String    @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  order_status     String    @default("PENDING_PAYMENT")
  // PENDING_PAYMENT | PROCESSING | MAKING | PACKING | SHIPPING | COMPLETED | CANCELLED
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  user             User?     @relation(fields: [user_id], references: [id])
  items            OrderItem[]
  payment          Payment?
  status_history   OrderStatusHistory[]
  email_logs       EmailLog[]

  @@map("orders")
}

model OrderItem {
  id               Int     @id @default(autoincrement())
  order_id         Int
  product_id       Int?
  product_name     String
  quantity         Int
  selected_options String? @db.Text // JSON snapshot
  custom_note      String? @db.Text
  price_snapshot   Decimal @db.Decimal(12, 2)
  total_price      Decimal @db.Decimal(12, 2)

  order            Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product          Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model OrderStatusHistory {
  id                  Int      @id @default(autoincrement())
  order_id            Int
  old_status          String
  new_status          String
  note                String?  @db.Text
  changed_by          String   // "SYSTEM" | "ADMIN" | "PAYMENT_WEBHOOK"
  changed_by_user_id  Int?
  created_at          DateTime @default(now())

  order               Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  user                User?    @relation(fields: [changed_by_user_id], references: [id])

  @@map("order_status_history")
}

// ─────────────────────────────────────────────
// PAYMENTS
// ─────────────────────────────────────────────
model Payment {
  id                  Int       @id @default(autoincrement())
  order_id            Int       @unique
  provider            String    // "vietqr_casso" | "vietqr_sepay" | "vnpay" | "momo"
  provider_payment_id String?
  bank_name           String?
  bank_account        String?
  account_name        String?
  amount              Decimal   @db.Decimal(12, 2)
  currency            String    @default("VND")
  transfer_content    String    // Nội dung CK để đối chiếu
  qr_code_url         String?   @db.Text
  qr_code_payload     String?   @db.Text
  transaction_code    String?   // Mã GD thật từ bank/provider
  status              String    @default("PENDING")
  // PENDING | PAID | FAILED | EXPIRED | CANCELLED
  paid_at             DateTime?
  expires_at          DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  order               Order     @relation(fields: [order_id], references: [id])
  webhook_events      PaymentWebhookEvent[]

  @@map("payments")
}

model PaymentWebhookEvent {
  id               Int       @id @default(autoincrement())
  provider         String
  event_id         String    @unique // Idempotency key
  transaction_code String?
  order_id         Int?
  payment_id       Int?
  raw_payload      Json      // Full raw payload for audit
  signature        String?   @db.Text
  status           String    @default("RECEIVED")
  // RECEIVED | VERIFIED | PROCESSED | FAILED | IGNORED
  error_message    String?   @db.Text
  processed_at     DateTime?
  created_at       DateTime  @default(now())

  payment          Payment?  @relation(fields: [payment_id], references: [id])

  @@map("payment_webhook_events")
}

// ─────────────────────────────────────────────
// EMAIL LOGS
// ─────────────────────────────────────────────
model EmailLog {
  id              Int       @id @default(autoincrement())
  order_id        Int?
  recipient_email String
  subject         String    @db.Text
  template_key    String
  status          String    @default("PENDING") // PENDING | SENT | FAILED
  error_message   String?   @db.Text
  sent_at         DateTime?
  created_at      DateTime  @default(now())

  order           Order?    @relation(fields: [order_id], references: [id], onDelete: SetNull)

  @@map("email_logs")
}

// ─────────────────────────────────────────────
// POSTS (Blog/News)
// ─────────────────────────────────────────────
model Post {
  id                        Int       @id @default(autoincrement())
  title                     String
  slug                      String    @unique
  excerpt                   String?   @db.Text
  content                   String?   @db.LongText
  featured_image            String?   @db.Text
  featured_image_alt        String?
  featured_image_caption    String?   @db.Text
  featured_image_description String?  @db.Text
  status                    String    @default("draft") // "draft" | "published" | "hidden"
  category_id               Int?
  seo_title                 String?
  meta_description          String?   @db.Text
  focus_keyword             String?
  author_id                 Int?
  published_at              DateTime?
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt

  category                  Category? @relation(fields: [category_id], references: [id])
  author                    User?     @relation(fields: [author_id], references: [id])
  tags                      PostTagMap[]

  @@map("posts")
}


model PostTag {
  id       Int          @id @default(autoincrement())
  name     String
  slug     String       @unique
  posts    PostTagMap[]

  @@map("post_tags")
}

model PostTagMap {
  post_id  Int
  tag_id   Int

  post     Post    @relation(fields: [post_id], references: [id], onDelete: Cascade)
  tag      PostTag @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([post_id, tag_id])
  @@map("post_tag_map")
}

// ─────────────────────────────────────────────
// CONTACTS
// ─────────────────────────────────────────────
model Contact {
  id         Int      @id @default(autoincrement())
  name       String
  email      String
  phone      String?
  message    String   @db.Text
  status     String   @default("unread") // "unread" | "read" | "replied"
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("contacts")
}

// ─────────────────────────────────────────────
// REVIEWS / TESTIMONIALS
// ─────────────────────────────────────────────
model Review {
  id          Int      @id @default(autoincrement())
  name        String
  avatar      String?
  content     String   @db.Text
  rating      Int      @default(5) // 1–5
  product_id  Int?
  is_featured Boolean  @default(false) // Hiện trang chủ
  status      String   @default("pending") // "pending" | "approved" | "rejected"
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  product     Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)

  @@map("reviews")
}

// ─────────────────────────────────────────────
// BANNERS
// ─────────────────────────────────────────────
model Banner {
  id                    Int      @id @default(autoincrement())
  image_url             String   @db.Text
  title                 String?  // Phụ kiện nhỏ,
  subtitle              String?  // cảm xúc lớn
  description           String?  @db.Text
  button_text           String?  // Khám phá ngay
  button_link           String?  // /san-pham
  secondary_button_text String?  // Tự thiết kế phụ kiện
  secondary_button_link String?  // /lien-he
  sort_order            Int      @default(0)
  status                String   @default("active") // "active" | "hidden"
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@map("banners")
}
